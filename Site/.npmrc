# Una versión debe tener una semana de publicada antes de que npm la resuelva. El
# gusano de npm de octubre de 2026 (tensorlake 0.5.144) y la ola de agosto duraron
# horas en el registro; una semana las rebasa a todas. Requiere npm >= 11.10 (Node
# 24.22.1 lo trae). El cooldown de Dependabot va un día por encima.
min-release-age=7
