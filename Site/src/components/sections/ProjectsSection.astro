---
import { getCollection } from 'astro:content';
import ProjectCard from '@components/ProjectCard.astro';
import Modal from '@components/Modal.astro';
import { type Locale, t } from '@/i18n/strings';

interface Props { locale: Locale }
const { locale } = Astro.props;

const order = ['axolovision', 'axolodao-system', 'axolodao-podcast'];
const all = await getCollection('projects');
const projects = order
  .map((slug) => all.find((p) => p.data.slug === slug))
  .filter((p): p is (typeof all)[number] => Boolean(p));
---

<section id="projects" class="scroll-mt-20 py-24">
  <div class="container-wide">
    <header class="mb-12 max-w-2xl">
      <h2 class="font-display text-4xl font-bold sm:text-5xl">{t(locale, 'projects.title')}</h2>
      <p class="mt-3 text-white/70">{t(locale, 'projects.subtitle')}</p>
    </header>

    <div class="grid gap-6 md:grid-cols-3">
      {projects.map((p) => (
        <ProjectCard project={p.data} locale={locale} modalId={`project-${p.data.slug}`} />
      ))}
    </div>
  </div>

  {projects.map((p) => (
    <Modal id={`project-${p.data.slug}`} locale={locale}>
      <div class="pt-8">
        <h3 class="font-display text-3xl">{p.data.name}</h3>
        <p class="mt-2 text-sm text-white/60">{p.data.blurb[locale]}</p>
        <p class="mt-6 leading-relaxed text-white/85">{p.data.description[locale]}</p>
        <div class="mt-8">
          {p.data.url ? (
            <a href={p.data.url} target="_blank" rel="noopener noreferrer" class="btn-primary">
              {p.data.cta?.[locale] ?? t(locale, 'projects.cta')}
            </a>
          ) : (
            <span class="badge-ocre">{t(locale, 'common.soon')}</span>
          )}
        </div>
      </div>
    </Modal>
  ))}
</section>
