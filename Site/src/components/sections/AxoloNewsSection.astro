---
import AxoloNewsPodcastCard from '@components/AxoloNewsPodcastCard.astro';
import { type Locale, t } from '@/i18n/strings';

interface Props { locale: Locale }
const { locale } = Astro.props;

// AxoloNews is the podcast. The Pulso rail (Instagram posts, one card per post) was retired on
// 13-nov-2026: its posts are not public, so every card led to a page a visitor could not open. The `news`
// collection stays: src/lib/podcast.ts reads it to tie each water week to its episode.
---

<section id="news" class="scroll-mt-20 py-16">
  <div class="container-wide">
    <header class="mb-10 max-w-2xl">
      <h2 class="font-display text-4xl font-bold sm:text-5xl">{t(locale, 'news.title')}</h2>
      <p class="mt-3 text-white/70">{t(locale, 'news.subtitle')}</p>
    </header>

    <div class="max-w-3xl">
      <AxoloNewsPodcastCard locale={locale} />
    </div>
  </div>
</section>
