---
import { getCollection } from 'astro:content';
import AxoloNewsInstagramCard from '@components/AxoloNewsInstagramCard.astro';
import AxoloNewsPodcastCard from '@components/AxoloNewsPodcastCard.astro';
import { groupByWeek } from '@/lib/pulso';
import { type Locale, t } from '@/i18n/strings';

interface Props { locale: Locale }
const { locale } = Astro.props;

// Six WEEKS, not six posts. Since W32 the Pulso is four posts a week, so a flat
// slice(0, 6) would show a week and a half and "Pulso #32" would stop reading as
// one thing. groupByWeek folds the chapters back into their week and sorts on
// the newest chapter each one holds.
const all = await getCollection('news');
const weeks = groupByWeek(all.map((n) => n.data)).slice(0, 6);
---

<section id="news" class="scroll-mt-20 py-16">
  <div class="container-wide">
    <header class="mb-10 max-w-2xl">
      <h2 class="font-display text-4xl font-bold sm:text-5xl">{t(locale, 'news.title')}</h2>
      <p class="mt-3 text-white/70">{t(locale, 'news.subtitle')}</p>
    </header>

    <div class="grid gap-6 md:grid-cols-2 md:items-start">
      <AxoloNewsInstagramCard weeks={weeks} locale={locale} />
      <AxoloNewsPodcastCard locale={locale} />
    </div>
  </div>
</section>
