---
import { type Locale, t } from '@/i18n/strings';
import { enlacesPrincipales } from '@/lib/navPrincipal';
import NuevaPestana from '@components/NuevaPestana.astro';
import HeroParallax from '@components/HeroParallax';
import { ATLAS_VERIFICADO, lineaOnchain, subtituloHero, tituloHero } from '@/lib/heroEstado';
import { conTaxones } from '@/lib/taxones';

interface Props { locale: Locale }
const { locale } = Astro.props;

// the header's three doors, on one line and in one style; Xolotlcalli's button lives in «Los datos, a la vista» as the case those data come from
const enlaces = enlacesPrincipales(locale);
// state B's onchain line; state A has none
const linea = lineaOnchain(locale);
---

<HeroParallax client:idle />

<section class="relative">
  <div class="container-tight pb-24 pt-24 text-center sm:pt-32">
    <h1 class="hero-title mx-auto max-w-3xl font-display text-4xl font-extrabold leading-tight sm:text-6xl" set:html={conTaxones(tituloHero(locale))} />

    <p class="hero-subtitle mx-auto mt-6 max-w-2xl text-lg" set:html={conTaxones(subtituloHero(locale))} />

    {linea && <p class="hero-onchain mx-auto mt-4 max-w-2xl text-sm font-semibold sm:text-base" data-hero-onchain set:html={conTaxones(linea)} />}

    <div class="mt-10 flex flex-col items-center gap-3">
      <div class="flex flex-wrap items-center justify-center gap-3">
        {enlaces.map((l) => (
          <a
            href={l.href}
            class="btn-secondary btn-secondary--compact"
            target={l.external ? '_blank' : undefined}
            rel={l.external ? 'noopener noreferrer' : undefined}
            data-hero-enlace={l.clave}
          >
            {l.label}{l.external && <NuevaPestana locale={locale} />}
          </a>
        ))}
      </div>
      {ATLAS_VERIFICADO && (
        <a href="/atlas/datos/huella/" class="mt-1 text-sm text-teal underline-offset-4 hover:underline" data-hero-verifica>
          {t(locale, 'hero.verifica')} <span aria-hidden="true">→</span>
        </a>
      )}
    </div>

    <div class="hero-disclosure-grid mx-auto mt-12 grid max-w-4xl gap-3 text-left sm:grid-cols-2 sm:items-stretch">
      <article class="hero-disclosure-item">
        <span class="badge-rosa">{t(locale, 'hero.problem.label')}</span>
        <h3 class="hero-disclosure-headline">{t(locale, 'hero.problem.headline')}</h3>
        <p class="hero-disclosure-text" set:html={conTaxones(t(locale, 'hero.problem.body'))} />
      </article>

      <article class="hero-disclosure-item">
        <span class="badge-teal">{t(locale, 'hero.solution.label')}</span>
        <h3 class="hero-disclosure-headline">{t(locale, 'hero.solution.headline')}</h3>
        <p class="hero-disclosure-text" set:html={conTaxones(t(locale, 'hero.solution.body'))} />
      </article>
    </div>
  </div>
</section>
