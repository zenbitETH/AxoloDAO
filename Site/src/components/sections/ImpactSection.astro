---
import { type Locale, t } from '@/i18n/strings';

interface Props { locale: Locale }
const { locale } = Astro.props;

const TX_URL = 'https://optimistic.etherscan.io/address/0xbdf701408ad237faa2d5d3177ae257af35265dbb';
const ETH_URL = 'https://debank.com/profile/0xbdf701408ad237faa2d5d3177ae257af35265dbb';

type Stat = { key: string; href?: string; external?: boolean };
const stats: Stat[] = [
  { key: 'species', href: '#mapa' },
  { key: 'custody', href: t(locale, 'ajolotes.path') },
  { key: 'visitors' },
  { key: 'tx', href: TX_URL, external: true },
  { key: 'eth', href: ETH_URL, external: true },
];
---

<section id="impact" class="scroll-mt-20 py-16">
  <div class="container-wide">
    <header class="mb-8 max-w-2xl">
      <h2 class="font-display text-3xl font-bold sm:text-4xl">{t(locale, 'impact.title')}</h2>
      <p class="mt-3 text-sm text-white/70 sm:text-base">{t(locale, 'impact.subtitle')}</p>
    </header>

    <p class="impact-since mb-6 text-center font-mono text-sm uppercase tracking-[0.25em] text-teal sm:text-base">
      {t(locale, 'impact.sinceLabel')}
    </p>

    <div class="grid grid-cols-2 gap-4 lg:grid-cols-5">
      {stats.map((s) => (
        s.href ? (
          <a
            href={s.href}
            target={s.external ? '_blank' : undefined}
            rel={s.external ? 'noopener noreferrer' : undefined}
            class:list={[
              'impact-card impact-card--link glass glass-hover block rounded-2xl p-6',
              s.external && 'impact-card--external',
            ]}
          >
            <p class="font-display text-5xl font-bold leading-none text-white sm:text-6xl">
              {t(locale, `impact.stat.${s.key}.value`)}
            </p>
            <p class="mt-4 text-sm text-white/85">{t(locale, `impact.stat.${s.key}.label`)}</p>
            <p class="mt-1 text-xs text-white/55">{t(locale, `impact.stat.${s.key}.sub`)}</p>
          </a>
        ) : (
          <article class="impact-card glass rounded-2xl p-6">
            <p class="font-display text-5xl font-bold leading-none text-white sm:text-6xl">
              {t(locale, `impact.stat.${s.key}.value`)}
            </p>
            <p class="mt-4 text-sm text-white/85">{t(locale, `impact.stat.${s.key}.label`)}</p>
            <p class="mt-1 text-xs text-white/55">{t(locale, `impact.stat.${s.key}.sub`)}</p>
          </article>
        )
      ))}
    </div>
  </div>
</section>

<style>
  /* Strong site-standard ease-out, mirrors transitions used elsewhere */
  :root {
    --impact-ease: cubic-bezier(0.23, 1, 0.32, 1);
  }

  /* Staggered entry — eyebrow first, then each card 60ms behind the last */
  .impact-since,
  .impact-card {
    opacity: 0;
    transform: translateY(8px);
    animation: impact-rise 420ms var(--impact-ease) forwards;
  }
  .impact-since {
    transform: translateY(4px);
    animation-duration: 360ms;
    animation-delay: 40ms;
  }
  .impact-card:nth-child(1) { animation-delay: 120ms; }
  .impact-card:nth-child(2) { animation-delay: 180ms; }
  .impact-card:nth-child(3) { animation-delay: 240ms; }
  .impact-card:nth-child(4) { animation-delay: 300ms; }
  .impact-card:nth-child(5) { animation-delay: 360ms; }

  @keyframes impact-rise {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Linked cards: lift on hover, press on active. Replace the .glass-hover
     transition list so transform joins bg/border without overriding them. */
  .impact-card--link {
    position: relative;
    transition:
      background-color 200ms ease,
      border-color 200ms ease,
      transform 200ms var(--impact-ease),
      box-shadow 220ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .impact-card--link:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 28px -12px rgba(0, 156, 156, 0.32);
    }
  }

  .impact-card--link:active {
    transform: scale(0.985);
    transition-duration: 100ms;
  }

  .impact-card--link:focus-visible {
    outline: 2px solid rgb(0 156 156);
    outline-offset: 3px;
  }

  /* External link affordance — always discoverable at low opacity, brightens
     on hover. Slight resting offset translates back to zero so motion signals
     "going somewhere." */
  .impact-card--external::after {
    content: '↗';
    position: absolute;
    top: 0.85rem;
    right: 1rem;
    font-size: 0.95rem;
    line-height: 1;
    color: rgb(255 255 255 / 0.35);
    transform: translate(-2px, 2px);
    transition:
      transform 220ms var(--impact-ease),
      color 200ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .impact-card--external:hover::after {
      transform: translate(0, 0);
      color: rgb(0 156 156);
    }
  }

  /* Reduced motion: keep meaning, lose movement */
  @media (prefers-reduced-motion: reduce) {
    .impact-since,
    .impact-card {
      opacity: 1;
      transform: none;
      animation: none;
    }
    .impact-card--link {
      transition: background-color 200ms ease, border-color 200ms ease;
    }
    .impact-card--link:hover,
    .impact-card--link:active {
      transform: none;
      box-shadow: none;
    }
    .impact-card--external::after {
      transform: none;
    }
  }
</style>
