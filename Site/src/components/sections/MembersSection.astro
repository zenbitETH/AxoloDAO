---
import { getCollection } from 'astro:content';
import MemberCard from '@components/MemberCard.astro';
import Modal from '@components/Modal.astro';
import { type Locale, t } from '@/i18n/strings';

interface Props { locale: Locale }
const { locale } = Astro.props;

const order = ['zenbit', 'xolotlcalli', 'ndali'];
const all = await getCollection('members');
const members = order
  .map((slug) => all.find((m) => m.data.slug === slug))
  .filter((m): m is (typeof all)[number] => Boolean(m));
---

<section id="members" class="scroll-mt-20 py-24">
  <div class="container-wide">
    <header class="mb-12 max-w-2xl">
      <h2 class="font-display text-4xl font-bold sm:text-5xl">{t(locale, 'members.title')}</h2>
      <p class="mt-3 text-white/70">{t(locale, 'members.subtitle')}</p>
    </header>

    <div class="grid gap-6 md:grid-cols-3">
      {members.map((m) => (
        <MemberCard member={m.data} locale={locale} modalId={`member-${m.data.slug}`} />
      ))}
    </div>
  </div>

  {members.map((m) => (
    <Modal id={`member-${m.data.slug}`} locale={locale}>
      <div class="pt-8 text-center">
        {m.data.logo && (
          <img
            src={m.data.logo}
            alt={`${m.data.name} logo`}
            data-slug={m.data.slug}
            class="member-modal-logo mx-auto block h-auto w-full max-w-xl"
          />
        )}
        <p class="mt-6 text-xl text-white/80">{m.data.role[locale]}</p>
        {m.data.ens && <p class="mt-2 font-mono text-sm text-teal">{m.data.ens}</p>}
        {m.data.slug === 'xolotlcalli' && (
          <div class="mt-4 flex flex-wrap justify-center gap-2">
            <a
              href={t(locale, 'wq.path')}
              class="rounded-full border border-teal/40 bg-teal/10 px-3 py-1 text-sm font-semibold text-teal hover:bg-teal/20"
            >{t(locale, 'wq.title')}</a>
            <a
              href={t(locale, 'ajolotes.path')}
              class="rounded-full border border-teal/40 bg-teal/10 px-3 py-1 text-sm font-semibold text-teal hover:bg-teal/20"
            >{t(locale, 'ajolotes.title')}</a>
          </div>
        )}
        <p class="mx-auto mt-8 max-w-2xl text-left text-lg leading-relaxed text-white/85">{m.data.description[locale]}</p>
        {(m.data.team ?? []).length > 0 && (
          <section class="mx-auto mt-8 max-w-2xl border-t border-white/10 pt-6 text-left">
            <h4 class="font-display text-xl">{t(locale, 'members.modal.team')}</h4>
            <div class="mt-4 grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4">
              {m.data.team.map((p) => (
                <div class="text-center">
                  {p.photo ? (
                    <img src={p.photo} alt={p.name} class="mx-auto h-20 w-20 rounded-full object-cover" />
                  ) : (
                    <div class="mx-auto grid h-20 w-20 place-items-center rounded-full border border-white/10 bg-white/[0.04] font-display text-2xl font-bold text-teal">
                      {p.name.split(/\s+/).map((w) => w[0]).slice(0, 2).join('')}
                    </div>
                  )}
                  <p class="mt-2 font-display text-sm font-semibold">{p.name}</p>
                  <p class="text-xs text-white/65">{p.title[locale]}</p>
                  {p.socials.length > 0 && (
                    <div class="mt-2 flex flex-wrap justify-center gap-1">
                      {p.socials.map((s) => (
                        <a
                          href={s.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="rounded-full border border-teal/40 bg-teal/10 px-2 py-0.5 text-[10px] font-semibold text-teal hover:bg-teal/20"
                        >{s.platform}</a>
                      ))}
                    </div>
                  )}
                </div>
              ))}
            </div>
          </section>
        )}
        {m.data.socials.length > 0 && (
          <div class="mt-6 flex flex-wrap justify-center gap-2">
            {m.data.socials.map((s) => (
              <a
                href={s.url}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-full border border-teal/40 bg-teal/10 px-3 py-1 text-sm font-semibold text-teal hover:bg-teal/20"
              >
                {s.platform}{s.handle ? ` · ${s.handle}` : ''}
              </a>
            ))}
          </div>
        )}
      </div>
    </Modal>
  ))}
</section>

<script>
  document.querySelectorAll('[data-modal]').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const id = trigger.getAttribute('data-modal');
      if (!id) return;
      const dlg = document.getElementById(id) as HTMLDialogElement | null;
      if (dlg) dlg.showModal();
    });
  });
</script>
