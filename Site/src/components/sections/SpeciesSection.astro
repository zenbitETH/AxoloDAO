---
import { getCollection } from 'astro:content';
import SpeciesExplorer from '@components/SpeciesExplorer';
import { type Locale, localePath, t } from '@/i18n/strings';
import bundle from '@/data/ajolotes/bundle.json';
import { ejemplarPhotoUrl, aliasSlug } from '@components/ajolotes/photos';

const mapSvgUrl = '/map/mexico-interactive.svg';
const bboxesUrl = '/map/state-bboxes.json';

interface Props { locale: Locale }
const { locale } = Astro.props;

const all = await getCollection('species');
const speciesData = all
  .map((s) => ({
    slug: s.data.slug,
    scientificName: s.data.scientificName,
    commonNames: s.data.commonNames,
    states: s.data.states,
    iucn: s.data.iucn,
    nom059: s.data.nom059,
    description: s.data.description,
    habitat: s.data.habitat,
    distribution: s.data.distribution,
    threats: s.data.threats,
    feeding: s.data.feeding,
    references: s.data.references ?? [],
    anp: s.data.anp ?? [],
    accentColor: s.data.accentColor,
    endemic: s.data.endemic,
    hasHeroCard: Boolean(s.data.heroCardSvg),
  }))
  .sort((a, b) => a.slug.localeCompare(b.slug));

const speciesPathBase = localePath(locale, 'especies/');

// Build the list of BioMuseo ajolotes shown inside each species detail modal.
// `bundle.ejemplares` is the LIVE roster by construction (data-ajolotes.mjs
// filters deceased + embargoed at ingest), so no hidden-alias list is needed
// here. Only ajolotes with an available photo (per components/ajolotes/photos.ts
// manifest) are included.
type RawEjemplar = { alias: string | null; especie: string };
const museumAjolotes = (bundle.ejemplares as RawEjemplar[])
  .map((e) => {
    if (!e.alias) return null;
    const photoUrl = ejemplarPhotoUrl(e.alias);
    if (!photoUrl) return null;
    return {
      alias: e.alias,
      slug: aliasSlug(e.alias),
      photoUrl,
      speciesSlug: e.especie.replace(/^A\.\s+/, ''),
    };
  })
  .filter((x): x is NonNullable<typeof x> => x !== null);

const ajolotesPath = t(locale, 'ajolotes.path');

const titleByLocale = {
  es: 'Ajolotes y achoques de México',
  en: 'Axolotls and achoques of Mexico',
  pt: 'Axolotes e achoques do México',
};
const legendNote = {
  es: '* De acuerdo a la Lista Roja de la Unión Internacional para la Conservación de la Naturaleza (UICN).',
  en: '* According to the IUCN Red List of Threatened Species.',
  pt: '* Segundo a Lista Vermelha da União Internacional para a Conservação da Natureza (UICN).',
};
---

<section id="mapa" class="scroll-mt-20 py-24">
  <div class="container-wide">
    <header class="mb-10">
      <h2 class="font-display text-4xl font-bold sm:text-5xl">{titleByLocale[locale]}</h2>
      <p class="mt-2 font-mono text-xs italic text-white/55 sm:text-sm md:whitespace-nowrap">{t(locale, 'species.taxonomy')}</p>
    </header>
  </div>
  <SpeciesExplorer
    client:visible
    species={speciesData}
    mapSvgUrl={mapSvgUrl}
    bboxesUrl={bboxesUrl}
    locale={locale}
    speciesPathBase={speciesPathBase}
    legendNote={legendNote[locale]}
    museumAjolotes={museumAjolotes}
    ajolotesPath={ajolotesPath}
  />
</section>
