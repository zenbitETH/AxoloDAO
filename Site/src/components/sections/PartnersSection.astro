---
import { getCollection } from 'astro:content';
import PartnerCard from '@components/PartnerCard.astro';
import { type Locale, t } from '@/i18n/strings';

interface Props { locale: Locale }
const { locale } = Astro.props;

const order = ['inteli', 'uaq', 'semarnat', 'secult-qro'];
const all = await getCollection('partners');
const sorted = order
  .map((slug) => all.find((p) => p.data.slug === slug))
  .filter((p): p is (typeof all)[number] => Boolean(p));
---

<section id="partners" class="scroll-mt-20 py-16">
  <div class="container-wide">
    <header class="mb-12 max-w-2xl">
      <h2 class="font-display text-4xl font-bold sm:text-5xl">{t(locale, 'partners.title')}</h2>
      <p class="mt-3 text-white/70">{t(locale, 'partners.subtitle')}</p>
    </header>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {sorted.map((p) => (
        <PartnerCard partner={p.data} locale={locale} />
      ))}
    </div>
  </div>
</section>

<style>
  /* Touch devices: tap toggles the detail slider open (hover handles desktop). */
  .partner-card.is-open .partner-detail {
    transform: translateY(0) !important;
    opacity: 1 !important;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.partner-card').forEach((card) => {
    card.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) return; // let links work
      card.classList.toggle('is-open');
    });
  });
</script>
