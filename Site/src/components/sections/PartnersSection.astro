---
import { getCollection } from 'astro:content';
import PartnerCard from '@components/PartnerCard.astro';
import Modal from '@components/Modal.astro';
import { type Locale, t } from '@/i18n/strings';

interface Props { locale: Locale }
const { locale } = Astro.props;

const all = await getCollection('partners');
const featured = all.filter((p) => p.data.featured);
const rest = all.filter((p) => !p.data.featured);
---

<section id="partners" class="scroll-mt-20 py-16">
  <div class="container-wide">
    <header class="mb-12 max-w-2xl">
      <h2 class="font-display text-4xl font-bold sm:text-5xl">{t(locale, 'partners.title')}</h2>
      <p class="mt-3 text-white/70">{t(locale, 'partners.subtitle')}</p>
    </header>

    <div class="grid gap-6 md:grid-cols-3">
      {featured.map((p) => (
        <PartnerCard partner={p.data} locale={locale} modalId={`partner-${p.data.slug}`} size="featured" />
      ))}
      {rest.map((p) => (
        <PartnerCard partner={p.data} locale={locale} modalId={`partner-${p.data.slug}`} />
      ))}
    </div>
  </div>

  {all.map((p) => (
    <Modal id={`partner-${p.data.slug}`} locale={locale}>
      <div class="pt-8">
        <div class="flex items-start gap-5">
          {p.data.logoMode === 'image' && p.data.logo ? (
            <img
              src={p.data.logo}
              alt={`${p.data.name} logo`}
              class:list={[
                'h-20 w-20 rounded-2xl p-2',
                p.data.featured ? 'bg-marfil' : 'bg-white/5',
              ]}
            />
          ) : (
            <div class="grid h-20 w-20 place-items-center rounded-2xl border border-white/10 bg-white/[0.03] font-display text-2xl font-bold text-teal">
              {p.data.name.split(/\s+/).map((w) => w[0]).slice(0, 3).join('')}
            </div>
          )}
          <div>
            <h3 class="font-display text-3xl">{p.data.name}</h3>
            <p class="text-white/70">{p.data.role[locale]}</p>
          </div>
        </div>
        <p class="mt-6 leading-relaxed text-white/85">{p.data.description[locale]}</p>
        {(p.data.socials.length > 0 || p.data.website) && (
          <div class="mt-6 flex flex-wrap gap-2">
            {p.data.website && (
              <a href={p.data.website} target="_blank" rel="noopener noreferrer" class="rounded-full border border-teal/40 bg-teal/10 px-3 py-1 text-xs font-semibold text-teal hover:bg-teal/20">website</a>
            )}
            {p.data.socials.map((s) => (
              <a href={s.url} target="_blank" rel="noopener noreferrer" class="rounded-full border border-teal/40 bg-teal/10 px-3 py-1 text-xs font-semibold text-teal hover:bg-teal/20">{s.platform}{s.handle ? ` · ${s.handle}` : ''}</a>
            ))}
          </div>
        )}
      </div>
    </Modal>
  ))}
</section>
