---
import { type Locale, t } from '@/i18n/strings';
import { CHAPTER_ACCENT, CHAPTER_ORDER, type PulsoWeek } from '@/lib/pulso';

interface Props {
  weeks: PulsoWeek[];
  locale: Locale;
}

const { weeks, locale } = Astro.props;

// `weeks` arrives sorted newest-first; the latest snaps first in the rail.
//
// The card is a <div>, not an <a>. Each week now holds up to four Instagram
// permalinks across two accounts, and nesting four links inside one would break
// the focus order and leave the card with a single aria-label describing four
// destinations. So the media links to the week's newest chapter — one tap still
// reaches the freshest post — and the chapter chips are its siblings.
const handles = [
  { user: 'zenbit.eth', url: 'https://www.instagram.com/zenbit.eth/' },
  { user: 'xolotlcalli.mx', url: 'https://www.instagram.com/xolotlcalli.mx/' },
  { user: 'ndali_centro_de_conexion', url: 'https://www.instagram.com/ndali_centro_de_conexion/' },
];
---

<article class="glass glass-hover flex flex-col overflow-hidden rounded-3xl p-6">
  <header class="mb-4">
    <h3 class="font-display text-2xl">{t(locale, 'news.instagram.title')}</h3>
    <p class="mt-1 line-clamp-1 text-sm text-white/70">{t(locale, 'news.instagram.subtitle')}</p>
  </header>

  {weeks.length > 0 ? (
    <div class="pulso-rail -mx-6 flex snap-x snap-mandatory gap-3 overflow-x-auto px-6 pb-2">
      {weeks.map((w) => {
        const published = new Map(w.chapters.map((c) => [c.chapter, c]));
        // A `semanal` week is the pre-W31 archive format: one post that carried
        // everything. It gets no chip strip, because there is nothing to pick.
        const showChips = !published.has('semanal');
        const hero = w.hero;
        return (
          <div class="group w-[78%] max-w-[260px] flex-shrink-0 snap-start">
            <a
              href={hero.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={hero.caption[locale]}
              class="block"
            >
              <div class="relative aspect-[4/5] overflow-hidden rounded-2xl border border-white/10 bg-white/[0.03]">
                {hero.video ? (
                  <video
                    src={hero.video}
                    poster={hero.poster ?? hero.image}
                    muted
                    loop
                    playsinline
                    preload="none"
                    aria-label={t(locale, 'news.instagram.playVideo')}
                    data-rail-video
                    class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
                  />
                ) : (
                  <img
                    src={hero.image}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
                  />
                )}
                {w.weekNumber !== undefined && (
                  <span class="absolute left-3 top-3 rounded-full bg-dark-navy/85 px-2.5 py-1 text-[11px] font-bold uppercase tracking-wider text-marfil backdrop-blur-sm">
                    Pulso #{w.weekNumber}
                  </span>
                )}
                {hero.video && (
                  <span class="pointer-events-none absolute right-3 top-3 grid h-7 w-7 place-items-center rounded-full bg-dark-navy/80 text-[10px] text-marfil backdrop-blur-sm">▶</span>
                )}
                <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/90 via-black/45 to-transparent p-3">
                  <p class="line-clamp-2 text-[11px] leading-snug text-white/95">
                    {hero.caption[locale]}
                  </p>
                </div>
              </div>
            </a>

            {showChips && (
              <div class="mt-2 flex flex-wrap gap-1.5">
                {CHAPTER_ORDER.map((c) => {
                  const post = published.get(c);
                  // Short label on the chip, full name in the accessible name:
                  // "Ajolote de la semana" wraps a four-chip strip onto two rows.
                  const label = t(locale, `news.chapter.short.${c}`);
                  const full = t(locale, `news.chapter.${c}`);
                  return post ? (
                    <a
                      href={post.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`Pulso ${w.weekNumber} · ${full}`}
                      class={`rounded-full px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider transition-opacity hover:opacity-80 ${CHAPTER_ACCENT[c]}`}
                    >{label}</a>
                  ) : (
                    // Not published yet. Shown rather than hidden so a Monday
                    // reads as "one of four is up", not as a one-post week.
                    <span
                      aria-hidden="true"
                      class="rounded-full border border-white/15 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-white/30"
                    >{label}</span>
                  );
                })}
              </div>
            )}
          </div>
        );
      })}
    </div>
  ) : (
    <p class="text-sm text-white/55">{t(locale, 'common.soon')}</p>
  )}

  <footer class="mt-5 flex flex-wrap items-center gap-2 text-sm">
    <span class="text-white/65">{t(locale, 'news.instagram.follow')}:</span>
    {handles.map((h) => (
      <a
        href={h.url}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-full border border-teal/40 bg-teal/10 px-3 py-1 text-xs font-semibold text-teal hover:bg-teal/20"
      >@{h.user}</a>
    ))}
  </footer>
</article>

<style>
  /* Hide native scrollbar on the rail while keeping horizontal snap-scroll. */
  .pulso-rail {
    -ms-overflow-style: none;
    scrollbar-width: none;
    scroll-padding-inline: 1.5rem;
  }
  .pulso-rail::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  // Rail video playback. `preload="none"` means nothing is fetched until the
  // visitor engages, which is the whole point — a rail of six autoplaying videos
  // is a mobile-data decision the site should not make on someone's behalf.
  //
  // Fine pointers play on hover/focus. Coarse pointers play only the card the
  // rail has snapped to, and only when the visitor has not asked for reduced
  // motion.
  const videos = Array.from(
    document.querySelectorAll<HTMLVideoElement>('video[data-rail-video]'),
  );

  if (videos.length) {
    const finePointer = window.matchMedia('(pointer: fine)');
    const stillMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    const play = (v: HTMLVideoElement) => {
      if (stillMotion.matches) return;
      void v.play().catch(() => {});
    };
    const stop = (v: HTMLVideoElement) => {
      v.pause();
      v.currentTime = 0;
    };

    if (finePointer.matches) {
      for (const v of videos) {
        const card = v.closest('.snap-start') ?? v;
        card.addEventListener('pointerenter', () => play(v));
        card.addEventListener('focusin', () => play(v));
        card.addEventListener('pointerleave', () => stop(v));
        card.addEventListener('focusout', () => stop(v));
      }
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            const v = e.target as HTMLVideoElement;
            if (e.isIntersecting) play(v);
            else stop(v);
          }
        },
        { threshold: 0.75 },
      );
      for (const v of videos) io.observe(v);
    }
  }
</script>
