---
import { type Locale, t } from '@/i18n/strings';

interface Props {
  id: string;
  locale: Locale;
}
const { id, locale } = Astro.props;
---

<dialog
  id={id}
  class="fixed inset-0 m-auto max-h-[90vh] w-[min(90vw,52rem)] rounded-3xl border border-white/10 bg-mid-navy/95 p-0 text-white shadow-neon-teal backdrop:bg-dark-navy/70 backdrop:backdrop-blur-md open:animate-[fadeIn_0.2s_ease]"
>
  <div class="sticky top-0 flex items-center justify-end border-b border-white/10 bg-mid-navy/95 p-3 backdrop-blur">
    <button
      type="button"
      data-close
      class="rounded-full border border-white/15 bg-white/5 px-4 py-1.5 text-sm font-medium text-white/80 hover:bg-white/10"
    >
      {t(locale, 'modal.close')}
    </button>
  </div>
  <div class="overflow-y-auto px-6 pb-8 sm:px-10">
    <slot />
  </div>
</dialog>

<script>
  // showModal pushes a history marker so the browser back button / iOS
  // back-swipe close the dialog. The popstate listener is only attached while
  // a dialog is actually open, so a dormant Modal.astro script can't intercept
  // popstate events meant for other patterns (e.g. the header menu).
  const DIALOG_STATE = 'axolodao:dialog';

  document.querySelectorAll('dialog').forEach((dlg) => {
    const native = dlg as HTMLDialogElement;
    let popstateHandler: ((e: PopStateEvent) => void) | null = null;
    let consumedByBack = false;

    const originalShowModal = native.showModal.bind(native);
    native.showModal = () => {
      originalShowModal();
      consumedByBack = false;
      history.pushState({ [DIALOG_STATE]: native.id || true }, '');
      popstateHandler = (e) => {
        // Only respond when OUR marker was popped — if a higher overlay was
        // stacked on top of us and just closed, the new state still has our
        // marker; leave us open.
        const state = e.state as Record<string, unknown> | null;
        if (state && state[DIALOG_STATE]) return;
        consumedByBack = true;
        native.close();
      };
      window.addEventListener('popstate', popstateHandler);
    };

    native.addEventListener('close', () => {
      if (popstateHandler) {
        window.removeEventListener('popstate', popstateHandler);
        popstateHandler = null;
      }
      if (consumedByBack) return;
      if (history.state && (history.state as Record<string, unknown>)[DIALOG_STATE]) {
        history.back();
      }
    });

    native.addEventListener('click', (e) => {
      if (e.target === native) native.close();
    });
    native.querySelectorAll('[data-close]').forEach((btn) => {
      btn.addEventListener('click', () => native.close());
    });
  });
</script>
