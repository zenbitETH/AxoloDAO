---
// The atlas on the home page, without a map (the map lives on /atlas/): the reach of the genus, Mexico to Canada, from the atlas
// inventory; what the atlas offers, in the home's captions; one button to the locale's atlas.
import { type Locale, localePath, t } from '@/i18n/strings';
import { uiText } from '@components/atlas/uiText';
import { atlas, cifra, llenar } from '@/lib/inventarioHome';
import { conTaxones } from '@/lib/taxones';

interface Props { locale: Locale }
const { locale } = Astro.props;
const total = atlas.especies.valor;
const paises = (['MX', 'US', 'CA'] as const).map((p) => ({ p, n: atlas.especies.porPais[p], nombre: uiText[locale].countries[p] }));
const fmt = new Intl.NumberFormat(locale === 'pt' ? 'pt-BR' : locale === 'en' ? 'en-US' : 'es-MX');
const rasgos = ['especies', 'recintos', 'mapa', 'capacidades', 'fuentes', 'abiertos']
  .map((k) => ({ k, texto: llenar(t(locale, `home.datos.atlas.${k}`), locale) }))
  .filter((r): r is { k: string; texto: string } => r.texto !== null);
const atlasHref = localePath(locale, 'atlas/');
---

<section id="atlas" class="scroll-mt-20 py-20" data-home-atlas>
  <div class="container-wide grid gap-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:items-start">
    <div>
      <h2 class="font-display text-4xl font-bold sm:text-5xl">{t(locale, 'home.datos.atlas.titulo')}</h2>
      <p class="cifra mt-6 font-display text-[6.5rem] font-extrabold leading-[0.85] sm:text-[8rem]" data-cifra="especies">{cifra('especies', locale)}</p>
      <p class="mt-3 text-base font-semibold">{t(locale, 'impact.stat.species.label')}</p>
      <p class="mt-1 text-sm text-white/65" set:html={conTaxones(t(locale, 'impact.stat.species.sub'))} />

      <ul class="mt-8 space-y-3" aria-label={paises.map((x) => `${x.nombre}: ${fmt.format(x.n)}`).join(', ')}>
        {paises.map((x) => (
          <li class="alcance grid grid-cols-[7.5rem_minmax(0,1fr)_2.5rem] items-center gap-3 text-sm">
            <span class="text-white/80">{x.nombre}</span>
            <span class="alcance-pista" aria-hidden="true"><span class="alcance-barra" style={`width:${(100 * x.n) / total}%`}></span></span>
            <span class="text-right font-display text-lg font-bold tabular-nums" data-cifra={`pais-${x.p}`}>{fmt.format(x.n)}</span>
          </li>
        ))}
      </ul>

      <a href={atlasHref} class="btn-primary mt-10 inline-flex" data-home-atlas-cta>{t(locale, 'home.datos.atlas.cta')}</a>
    </div>

    <ul class="rasgos grid gap-x-10 sm:grid-cols-2">
      {rasgos.map((r) => (
        <li class="rasgo flex gap-4 py-5" data-rasgo={r.k}>
          <span class="rasgo-icono" aria-hidden="true">
            {r.k === 'especies' && <svg viewBox="0 0 24 24"><path d="M4 14c3-6 13-6 16 0M7 13l-2-3M17 13l2-3M9 16.5c1.8 1.3 4.2 1.3 6 0"/></svg>}
            {r.k === 'recintos' && <svg viewBox="0 0 24 24"><path d="M12 21s-6-5.2-6-10a6 6 0 0 1 12 0c0 4.8-6 10-6 10z"/><circle cx="12" cy="11" r="2.2"/></svg>}
            {r.k === 'mapa' && <svg viewBox="0 0 24 24"><path d="M3 6l6-2 6 2 6-2v14l-6 2-6-2-6 2zM9 4v14M15 6v14"/></svg>}
            {r.k === 'capacidades' && <svg viewBox="0 0 24 24"><path d="M12 3v18M7 7l5 3 5-3M7 13l5 3 5-3"/></svg>}
            {r.k === 'fuentes' && <svg viewBox="0 0 24 24"><path d="M6 3h9l3 3v15H6zM9 9h6M9 13h6M9 17h4"/></svg>}
            {r.k === 'abiertos' && <svg viewBox="0 0 24 24"><path d="M4 7h16v12H4zM4 7l2-3h12l2 3M9 12h6"/></svg>}
          </span>
          <p class="text-sm leading-relaxed text-white/85 sm:text-base" set:html={conTaxones(r.texto)} />
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* the big figure, the bars and the icons take the theme's teal text token (globals.css): ≥ 4.5:1 for text, ≥ 3:1 for the bars on their track */
  .cifra { color: var(--texto-teal); }
  .alcance-pista { display: block; height: 0.5rem; border-radius: 999px; background: rgba(var(--text-rgb), 0.1); overflow: hidden; }
  .alcance-barra { display: block; height: 100%; border-radius: 999px; background: var(--texto-teal); }
  .rasgo { border-top: 1px solid rgba(var(--text-rgb), 0.12); }
  .rasgo-icono { flex: none; width: 2rem; height: 2rem; color: var(--texto-teal); }
  .rasgo-icono svg { width: 100%; height: 100%; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
</style>
