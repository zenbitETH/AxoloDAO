---
import type { CollectionEntry } from 'astro:content';
import { type Locale, t } from '@/i18n/strings';

interface Props {
  partner: CollectionEntry<'partners'>['data'];
  locale: Locale;
  modalId: string;
  size?: 'normal' | 'featured';
}
const { partner, locale, modalId, size = 'normal' } = Astro.props;
const role = partner.role[locale];
const featuredLabel = partner.featuredLabel?.[locale] ?? t(locale, 'partners.featured');
const isFeatured = size === 'featured';
---

<button
  type="button"
  data-modal={modalId}
  class:list={[
    'glass glass-hover group w-full rounded-3xl p-6 text-left',
    isFeatured && 'border-rosa/30 bg-rosa/5 hover:shadow-neon-rosa hover:border-rosa/60',
  ]}
>
  {isFeatured && (
    <span class="badge-rosa mb-3 inline-flex">{featuredLabel}</span>
  )}
  <div class="flex items-start gap-4">
    {partner.logoMode === 'image' && partner.logo ? (
      <img
        src={partner.logo}
        alt={`${partner.name} logo`}
        class:list={[
          'h-14 w-14 rounded-2xl p-1.5',
          isFeatured ? 'bg-marfil shadow-neon-rosa/30' : 'bg-white/5',
        ]}
      />
    ) : (
      <div class="grid h-14 w-14 place-items-center rounded-2xl border border-white/10 bg-white/[0.03] font-display text-base font-bold text-teal">
        {partner.name.split(/\s+/).map((w) => w[0]).slice(0, 3).join('')}
      </div>
    )}
    <div class="flex-1">
      <h3 class="font-display text-xl">{partner.name}</h3>
      <p class="text-sm text-white/70">{role}</p>
    </div>
  </div>
</button>
