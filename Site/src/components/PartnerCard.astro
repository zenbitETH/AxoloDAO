---
import type { CollectionEntry } from 'astro:content';
import { type Locale, t } from '@/i18n/strings';

interface Props {
  partner: CollectionEntry<'partners'>['data'];
  locale: Locale;
}
const { partner, locale } = Astro.props;
const role = partner.role[locale];
const useImage = partner.logoMode === 'image' && partner.logo;
const isGov = partner.kind === 'government';
const ribbon = partner.ribbon?.[locale] ?? partner.featuredLabel?.[locale] ?? '';

// Italicize an abbreviated Ambystoma epithet (e.g. "A. velasci") per scientific
// style. The ribbon text is trusted (authored in YAML), so set:html is safe.
function sciItalic(s: string): string {
  return s.replace(
    /\bA\.\s+(mexicanum|velasci|dumerilii|andersoni|taylori|altamirani|granulosum|leorae|rivulare|amblycephalum|flavipiperatum)\b/g,
    '<em>$&</em>',
  );
}
const links = [
  ...(partner.website ? [{ label: t(locale, 'partners.website'), url: partner.website }] : []),
  ...partner.socials.map((s) => ({ label: `${s.platform}${s.handle ? ` · ${s.handle}` : ''}`, url: s.url })),
];
---

<article
  tabindex="0"
  class:list={[
    'partner-card group relative flex h-full flex-col overflow-hidden rounded-3xl glass glass-hover',
    isGov ? 'hover:border-rosa/50' : 'hover:border-teal/50',
  ]}
>
  {/* Front face */}
  <div class="flex flex-1 flex-col p-5">
    {ribbon && (
      <span
        class:list={[
          'mb-3 inline-flex w-fit rounded-full px-3 py-1 text-[11px] font-bold uppercase tracking-wide',
          isGov ? 'bg-rosa/15 text-rosa' : 'bg-teal/15 text-teal',
        ]}
        set:html={sciItalic(ribbon)}
      />
    )}
    <div class="mb-3 flex h-16 items-center justify-center rounded-2xl bg-white px-4 shadow-sm">
      {useImage ? (
        <img src={partner.logo} alt={`${partner.name} logo`} class="max-h-10 max-w-full object-contain" loading="lazy" />
      ) : (
        <span class="font-display text-xl font-bold text-navy">{partner.name}</span>
      )}
    </div>
    <h3 class="font-display text-xl leading-tight text-white">{partner.name}</h3>
    <p class="mt-1 line-clamp-2 text-sm text-white/70">{role}</p>
    <span class:list={['mt-auto pt-3 text-[11px] font-semibold uppercase tracking-wide', isGov ? 'text-rosa/70' : 'text-teal/70']}>
      {t(locale, 'species.detail.full')}
    </span>
  </div>

  {/* Detail slider — covers the full card (hover / keyboard focus / tap) */}
  <div
    class:list={[
      'partner-detail absolute inset-0 flex translate-y-full flex-col rounded-3xl p-5 opacity-0 transition-all duration-300 ease-out',
      'group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:translate-y-0 group-focus-within:opacity-100',
      'motion-reduce:transition-none',
      isGov ? 'bg-[#2a141a]' : 'bg-[#06343a]',
    ]}
  >
    {ribbon && (
      <span
        class:list={[
          'mb-2 inline-flex w-fit rounded-full px-3 py-1 text-[11px] font-bold uppercase tracking-wide',
          isGov ? 'bg-rosa/20 text-rosa' : 'bg-teal/20 text-teal',
        ]}
        set:html={sciItalic(ribbon)}
      />
    )}
    <h3 class="font-display text-lg leading-tight text-white">{partner.name}</h3>
    <p class="mt-2 min-h-0 flex-1 overflow-auto pr-1 text-sm leading-relaxed text-white/85">{partner.description[locale]}</p>
    {links.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-2">
        {links.map((l) => (
          <a
            href={l.url}
            target="_blank"
            rel="noopener noreferrer"
            class:list={[
              'rounded-full border px-3 py-1 text-xs font-semibold transition-colors',
              isGov ? 'border-rosa/40 bg-rosa/10 text-rosa hover:bg-rosa/20' : 'border-teal/40 bg-teal/10 text-teal hover:bg-teal/20',
            ]}
          >
            {l.label}
          </a>
        ))}
      </div>
    )}
  </div>
</article>
