---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { t } from '@/i18n/strings';

const locale = 'pt';
---

<BaseLayout
  locale={locale}
  title={`${t(locale, 'xolotlcalli.title')} — AxoloDAO`}
  description={t(locale, 'xolotlcalli.subtitle')}
>
  <section class="mx-auto max-w-5xl px-4 py-14 sm:py-20">
    <header class="mb-10 flex items-start gap-5 sm:gap-7">
      <img
        src="/logos/xolotlcalliicon.svg"
        alt=""
        class="h-14 w-14 flex-shrink-0 sm:h-20 sm:w-20"
      />
      <div>
        <p class="font-display text-xs uppercase tracking-widest text-teal">
          {t(locale, 'nav.xolotlcalli')}
        </p>
        <h1 class="mt-1 font-display text-3xl sm:text-5xl">
          {t(locale, 'xolotlcalli.title')}
        </h1>
        <p class="mt-3 max-w-2xl font-body text-base text-white/75 sm:text-lg">
          {t(locale, 'xolotlcalli.subtitle')}
        </p>
      </div>
    </header>

    <div class="grid gap-5 sm:grid-cols-2">
      <a
        href={t(locale, 'wq.path')}
        class="group glass glass-hover rounded-3xl p-6 transition hover:-translate-y-0.5 sm:p-8"
      >
        <div class="flex items-center gap-4">
          <div class="grid h-12 w-12 place-items-center rounded-2xl bg-teal/15 font-display text-2xl text-teal">
            ≈
          </div>
          <h2 class="font-display text-2xl sm:text-3xl">
            {t(locale, 'xolotlcalli.card.water.title')}
          </h2>
        </div>
        <p class="mt-4 font-body text-sm text-white/75 sm:text-base">
          {t(locale, 'xolotlcalli.card.water.desc')}
        </p>
        <p class="mt-5 font-display text-sm text-teal group-hover:translate-x-0.5 transition">
          → {t(locale, 'wq.title')}
        </p>
      </a>

      <div class="rounded-3xl border border-white/10 bg-white/[0.02] p-6 sm:p-8">
        <div class="flex items-center gap-4">
          <div class="grid h-12 w-12 place-items-center rounded-2xl bg-rosa/15 font-display text-2xl text-rosa">
            ☆
          </div>
          <h2 class="font-display text-2xl text-white/80 sm:text-3xl">
            {t(locale, 'xolotlcalli.card.axolotls.title')}
          </h2>
        </div>
        <p class="mt-4 font-body text-sm text-white/60 sm:text-base">
          {t(locale, 'xolotlcalli.card.axolotls.desc')}
        </p>
        <p class="mt-5 inline-flex rounded-full bg-white/5 px-3 py-1 font-display text-xs uppercase tracking-wider text-white/60">
          {t(locale, 'common.soon')}
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
