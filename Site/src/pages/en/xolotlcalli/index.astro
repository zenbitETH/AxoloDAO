---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { MUSEO_WORDMARK_SVG } from '@/lib/wordmark';
import ClosureBanner from '@components/ClosureBanner.astro';
import SurvivalStat from '@components/SurvivalStat.astro';
import WaterQualityDashboard from '@components/waterQuality/WaterQualityDashboard';
import tanksRaw from '@/data/water-quality/tanks.json';
import parametersRaw from '@/data/water-quality/parameters.json';
import mondaysRaw from '@/data/water-quality/measurements-mondays.json';
import bundleRaw from '@/data/ajolotes/bundle.json';
import bitacoraRaw from '@/data/ops/bitacora-recent.json';
import type { Tank, ParameterCatalogEntry, Measurement } from '@components/waterQuality/types';
import type { Bundle, BitacoraEntry } from '@components/ajolotes/types';
import { t } from '@/i18n/strings';
import { podcastByWeek, episodeUrls, PODCAST_PLAYLIST_URL } from '@/lib/podcast';
import { ANIMALS_AWAY_FROM_MUSEUM } from '@/lib/closure';

const locale = 'en';
const tanks = tanksRaw as unknown as Tank[];
const parameters = parametersRaw as unknown as ParameterCatalogEntry[];
const mondays = mondaysRaw as unknown as Measurement[];
const bitacora = bitacoraRaw as unknown as BitacoraEntry[];
const podcastMap = await podcastByWeek();
const podcastEpisodeUrls = episodeUrls();

// `bundle.ejemplares` is the LIVE roster by construction: data-ajolotes.mjs
// filters deceased + embargoed specimens at ingest, so no per-page list is needed.
// While every axolotl is outside the museum, the stations list nobody:
// a tank's specimens and the per-aquarium tiles would place animals where they are not.
// The registry (/xolotlcalli/ajolotes) keeps every record.
const ejemplares = ANIMALS_AWAY_FROM_MUSEUM ? [] : (bundleRaw as unknown as Bundle).ejemplares;

const logoSvg = MUSEO_WORDMARK_SVG;
---

<BaseLayout
  locale={locale}
  title={`${t(locale, 'wq.title')} — Museo de Ajolotes Xolotlcalli`}
  description={t(locale, 'wq.subtitle')}
>
  <section class="wq-surface relative">
    <WaterQualityDashboard
      client:load
      locale={locale}
      tanks={tanks}
      parameters={parameters}
      mondays={mondays}
      ejemplares={ejemplares}
      bitacora={bitacora}
      allDataUrl="/data/water-quality/measurements-all.json"
      podcastByWeek={podcastMap}
      episodeUrls={podcastEpisodeUrls}
      podcastUrl={PODCAST_PLAYLIST_URL}
      logoSvg={logoSvg}
      title={t(locale, 'wq.title')}
      subtitle={t(locale, 'wq.subtitle')}
    >
      <ClosureBanner locale={locale} />
      <SurvivalStat locale={locale} />
    </WaterQualityDashboard>
  </section>
</BaseLayout>

<style is:global>
  .wq-surface {
    background-color: #F6EFE0;
  }
  [data-theme='dark'] .wq-surface {
    background-color: #11202A;
  }
  .wq-logo-mark {
    display: inline-block;
    width: 100%;
    max-width: min(68vw, 240px);
  }
  .wq-logo-mark svg {
    width: 100%;
    height: auto;
    display: block;
  }
  @media (min-width: 640px) {
    .wq-logo-mark {
      width: auto;
      max-width: none;
      height: 3rem;
    }
    .wq-logo-mark svg {
      height: 100%;
      width: auto;
    }
  }
</style>
