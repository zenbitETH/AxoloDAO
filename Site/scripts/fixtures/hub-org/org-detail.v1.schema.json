{
  "$id": "@zenbit/schemas/json/api/org-detail.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^(?!.*--)[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?$"
    },
    "orgUid": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "displayName": {
      "type": "string"
    },
    "orgType": {
      "type": "integer",
      "minimum": 1,
      "maximum": 6
    },
    "legalFigure": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "state": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "MX-AGU",
            "MX-BCN",
            "MX-BCS",
            "MX-CAM",
            "MX-COA",
            "MX-COL",
            "MX-CHP",
            "MX-CHH",
            "MX-CMX",
            "MX-DUR",
            "MX-GUA",
            "MX-GRO",
            "MX-HID",
            "MX-JAL",
            "MX-MEX",
            "MX-MIC",
            "MX-MOR",
            "MX-NAY",
            "MX-NLE",
            "MX-OAX",
            "MX-PUE",
            "MX-QUE",
            "MX-ROO",
            "MX-SLP",
            "MX-SIN",
            "MX-SON",
            "MX-TAB",
            "MX-TAM",
            "MX-TLA",
            "MX-VER",
            "MX-YUC",
            "MX-ZAC"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "verification": {
      "type": "object",
      "properties": {
        "level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "method": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "expiresAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "level",
        "method",
        "expiresAt"
      ],
      "additionalProperties": false
    },
    "species": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "receivesVisitors": {
      "type": "boolean"
    },
    "ensName": {
      "type": [
        "string",
        "null"
      ]
    },
    "listedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "collectives": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "maxLength": 32,
            "pattern": "^(?!.*--)[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?$"
          },
          "collectiveUid": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}$"
          },
          "primary": {
            "type": "boolean"
          }
        },
        "required": [
          "slug",
          "collectiveUid",
          "primary"
        ],
        "additionalProperties": false
      }
    },
    "publicDescription": {
      "type": [
        "string",
        "null"
      ]
    },
    "sites": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "siteUid": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}$"
          },
          "state": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "MX-AGU",
                  "MX-BCN",
                  "MX-BCS",
                  "MX-CAM",
                  "MX-COA",
                  "MX-COL",
                  "MX-CHP",
                  "MX-CHH",
                  "MX-CMX",
                  "MX-DUR",
                  "MX-GUA",
                  "MX-GRO",
                  "MX-HID",
                  "MX-JAL",
                  "MX-MEX",
                  "MX-MIC",
                  "MX-MOR",
                  "MX-NAY",
                  "MX-NLE",
                  "MX-OAX",
                  "MX-PUE",
                  "MX-QUE",
                  "MX-ROO",
                  "MX-SLP",
                  "MX-SIN",
                  "MX-SON",
                  "MX-TAB",
                  "MX-TAM",
                  "MX-TLA",
                  "MX-VER",
                  "MX-YUC",
                  "MX-ZAC"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "municipalityCode": {
            "type": [
              "string",
              "null"
            ]
          },
          "latGen": {
            "type": [
              "number",
              "null"
            ]
          },
          "lonGen": {
            "type": [
              "number",
              "null"
            ]
          },
          "gridCdeg": {
            "type": "integer",
            "minimum": 10,
            "maximum": 100
          },
          "licence": {
            "type": "object",
            "properties": {
              "spdx": {
                "type": "string",
                "pattern": "^[A-Za-z0-9.+-]+$"
              },
              "commercialOk": {
                "type": "boolean"
              },
              "attributionRequired": {
                "type": "boolean"
              }
            },
            "required": [
              "spdx",
              "commercialOk",
              "attributionRequired"
            ],
            "additionalProperties": false
          },
          "units": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "unitUid": {
                  "type": "string",
                  "pattern": "^0x[0-9a-f]{64}$"
                },
                "slug": {
                  "type": "string",
                  "maxLength": 32,
                  "pattern": "^(?!.*--)[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?$"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "exhibicion",
                    "sistema",
                    "auxiliar"
                  ]
                },
                "parent": {
                  "type": "null"
                },
                "species": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "unitUid",
                "slug",
                "kind",
                "parent",
                "species"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "siteUid",
          "state",
          "municipalityCode",
          "latGen",
          "lonGen",
          "gridCdeg",
          "licence",
          "units"
        ],
        "additionalProperties": false
      }
    },
    "historical": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "fromWeek": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-W(0[1-9]|[1-4]\\d|5[0-3])$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "toWeek": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-W(0[1-9]|[1-4]\\d|5[0-3])$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "figures": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "enum": [
                      "survival_simple"
                    ]
                  },
                  "value": {
                    "type": "string",
                    "pattern": "^\\d{1,3}(\\.\\d{1,2})?$"
                  },
                  "unit": {
                    "type": "string",
                    "enum": [
                      "percent"
                    ]
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "note": {
                    "type": "string",
                    "minLength": 1
                  },
                  "source": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "key",
                  "value",
                  "unit",
                  "label",
                  "note",
                  "source"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "fromWeek",
            "toWeek",
            "figures"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "frozen": {
      "type": "boolean"
    },
    "frozenAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "stage": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "reached": {
              "anyOf": [
                {
                  "anyOf": [
                    {
                      "type": "number",
                      "const": 0
                    },
                    {
                      "type": "number",
                      "const": 1
                    },
                    {
                      "type": "number",
                      "const": 2
                    }
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "missing": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "registration_reviewed",
                  "slug_reserved",
                  "legal_figure_declared",
                  "protocol_accepted",
                  "first_week_captured",
                  "weeks_closed_8_of_12",
                  "irc_50",
                  "record_60",
                  "verification_peer_or_document",
                  "safe_two_signers",
                  "two_eyes_active",
                  "survival_computed",
                  "irc_70",
                  "record_90",
                  "verification_document",
                  "expert_reviews_two",
                  "public_treasury_flows",
                  "open_licence",
                  "weeks_26",
                  "survival_reviewed"
                ]
              }
            },
            "inReview": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "registration_reviewed",
                  "slug_reserved",
                  "legal_figure_declared",
                  "protocol_accepted",
                  "first_week_captured",
                  "weeks_closed_8_of_12",
                  "irc_50",
                  "record_60",
                  "verification_peer_or_document",
                  "safe_two_signers",
                  "two_eyes_active",
                  "survival_computed",
                  "irc_70",
                  "record_90",
                  "verification_document",
                  "expert_reviews_two",
                  "public_treasury_flows",
                  "open_licence",
                  "weeks_26",
                  "survival_reviewed"
                ]
              }
            },
            "countdown": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "requirement": {
                      "type": "string",
                      "enum": [
                        "registration_reviewed",
                        "slug_reserved",
                        "legal_figure_declared",
                        "protocol_accepted",
                        "first_week_captured",
                        "weeks_closed_8_of_12",
                        "irc_50",
                        "record_60",
                        "verification_peer_or_document",
                        "safe_two_signers",
                        "two_eyes_active",
                        "survival_computed",
                        "irc_70",
                        "record_90",
                        "verification_document",
                        "expert_reviews_two",
                        "public_treasury_flows",
                        "open_licence",
                        "weeks_26",
                        "survival_reviewed"
                      ]
                    },
                    "at": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                    }
                  },
                  "required": [
                    "requirement",
                    "at"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "reached",
            "missing",
            "inReview",
            "countdown"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "span": {
      "type": "object",
      "properties": {
        "fromWeek": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-W(0[1-9]|[1-4]\\d|5[0-3])$"
            },
            {
              "type": "null"
            }
          ]
        },
        "toWeek": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-W(0[1-9]|[1-4]\\d|5[0-3])$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "fromWeek",
        "toWeek"
      ],
      "additionalProperties": false
    },
    "profileSha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "registeredUid": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "origen": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "slug",
          "orgUid",
          "displayName",
          "orgType",
          "legalFigure",
          "state",
          "verification",
          "species",
          "receivesVisitors",
          "ensName",
          "listedAt",
          "collectives",
          "publicDescription",
          "sites",
          "historical",
          "frozen",
          "frozenAt",
          "stage",
          "span",
          "profileSha256",
          "registeredUid"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "estado": {
            "type": "string",
            "enum": [
              "en-cadena",
              "previsto",
              "hub"
            ]
          },
          "esquema": {
            "type": "string",
            "enum": [
              "OrgRegistered@2",
              "OrgVerification@2",
              "WeekAnchor@2",
              "WeeklyUnitMetrics@2",
              "DailyRecord@2",
              "OpenDatasetSnapshot@1",
              "ClipConfirmation@1",
              "ENS"
            ]
          },
          "uid": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}$"
          }
        },
        "required": [
          "estado"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "slug",
    "orgUid",
    "displayName",
    "orgType",
    "legalFigure",
    "state",
    "verification",
    "species",
    "receivesVisitors",
    "ensName",
    "listedAt",
    "collectives",
    "publicDescription",
    "sites",
    "historical",
    "frozen",
    "frozenAt",
    "stage",
    "span",
    "profileSha256",
    "registeredUid",
    "origen"
  ],
  "additionalProperties": false
}
