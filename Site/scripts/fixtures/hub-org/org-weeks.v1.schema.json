{
  "$id": "@zenbit/schemas/json/api/org-weeks.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "org": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^(?!.*--)[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?$"
    },
    "orgUid": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "weeks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "week": {
            "type": "string",
            "pattern": "^\\d{4}-W(0[1-9]|[1-4]\\d|5[0-3])$"
          },
          "publicDailiesByType": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "enum": [
                "water_reading",
                "ethogram_session",
                "maintenance"
              ]
            },
            "additionalProperties": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "publicRecords": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "anchor": {
            "type": "object",
            "properties": {
              "sequence": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "uid": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^0x[0-9a-f]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "flags": {
                "type": "integer",
                "minimum": 0,
                "maximum": 15
              }
            },
            "required": [
              "sequence",
              "uid",
              "flags"
            ],
            "additionalProperties": false
          },
          "origen": {
            "type": "object",
            "properties": {
              "estado": {
                "type": "string",
                "enum": [
                  "en-cadena",
                  "previsto",
                  "hub"
                ]
              },
              "esquema": {
                "type": "string",
                "enum": [
                  "OrgRegistered@2",
                  "OrgVerification@2",
                  "WeekAnchor@2",
                  "WeeklyUnitMetrics@2",
                  "DailyRecord@2",
                  "OpenDatasetSnapshot@1",
                  "ClipConfirmation@1",
                  "ENS"
                ]
              },
              "uid": {
                "type": "string",
                "pattern": "^0x[0-9a-f]{64}$"
              }
            },
            "required": [
              "estado"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "week",
          "publicDailiesByType",
          "publicRecords",
          "anchor",
          "origen"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "org",
    "orgUid",
    "weeks"
  ],
  "additionalProperties": false
}
