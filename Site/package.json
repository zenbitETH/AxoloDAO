{
  "name": "axolodao-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "prebuild": "node scripts/check-fechas.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "data:map": "node scripts/tag-mexico-map.mjs",
    "data:species": "node scripts/extract-species.mjs",
    "data:tables": "node scripts/build-control-tables.mjs",
    "data:water": "node scripts/data-water.mjs",
    "data:ajolotes": "node scripts/data-ajolotes.mjs",
    "data:ops": "node scripts/data-ops.mjs",
    "data:all": "npm run data:map && npm run data:species && npm run data:tables && npm run data:water && npm run data:ajolotes && npm run data:ops",
    "test:no-personal-data": "node scripts/test-no-personal-data.mjs",
    "test:agua-rangos": "node scripts/test-agua-rangos.mjs",
    "test:data-water": "node scripts/test-data-water-bot.mjs && node scripts/test-data-water-suspect-rows.mjs",
    "test:closure-copy": "node --experimental-strip-types --no-warnings scripts/test-closure-copy.mjs",
    "test:closure-copy:dist": "node --experimental-strip-types --no-warnings scripts/test-closure-copy.mjs --dist",
    "test:fechas": "node scripts/test-fechas.mjs",
    "test:embargo": "node scripts/test-embargo.mjs",
    "test:no-embargo-in-dist": "node scripts/test-embargo.mjs --dist"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/preact": "^4.0.0",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/tailwind": "^5.1.4",
    "@vercel/analytics": "^2.0.1",
    "astro": "^5.0.0",
    "preact": "^10.25.0",
    "qrcode": "^1.5.4",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "node-html-parser": "^7.0.1",
    "svgo": "^3.3.2",
    "xlsx": "^0.18.5",
    "yaml": "^2.9.1"
  }
}
